# FMSound がビルド時に参照する upstream の固定リビジョン一覧。
#
# .github/workflows/pages.yml (CI) と README.md のビルド手順の両方が、
# ここに書かれた値だけを参照する(値を二重管理しない)。
#
# 固定する理由: mucomweb/patches/ の2本のパッチ(0001-cmucom-expose-vm.patch,
# 0002-fmgen-leveldata.patch)は upstream/MucomWeb/mucom88 の「特定の内容」に
# しか当たらないように作られている。当たらなければビルドが失敗する設計
# (mucomweb/CMakeLists.txt 参照)。upstream が更新されると、こちらは何も
# 変えていないのにある日突然 CI が落ちる。リビジョンを固定すれば、同じ
# FMSound のコミットからは常に同じ upstream ソースがビルドされる。
#
# 更新する場合は、この4値を書き換えたうえでローカルで両ドライバを再ビルドし、
# tools/verify_*.mjs (27本) が全PASSすることを確認してからコミットすること
# (パッチが当たらなくなっていないか、mucom88 submodule 側の変更で挙動が
# 変わっていないか、を機械的に確認するため)。

UPSTREAM_98FMPLAYER_REPO=https://github.com/myon98/98fmplayer.git
UPSTREAM_98FMPLAYER_REV=4fa914e4b2b994cb3ccf92d571a20a7cdf1fe36a

UPSTREAM_MUCOMWEB_REPO=https://github.com/aosoft/MucomWeb.git
UPSTREAM_MUCOMWEB_REV=3df9d6b79bb51ca9f28061a242db2be85b82443a

# MucomWeb が同梱する mucom88 (aosoft/mucom88) は git submodule で、
# 実際のコミットは UPSTREAM_MUCOMWEB_REV 側のツリーに gitlink として
# 記録されているため、上の2値を固定すれば連動して決まる。以下の2値は
# 「本当に想定通りの中身が取れたか」をCI/ローカルで自己検証するための
# 参照値(workflow内で一致確認に使う)。
UPSTREAM_MUCOM88_SUBMODULE_REPO=https://github.com/aosoft/mucom88.git
UPSTREAM_MUCOM88_SUBMODULE_REV=15f99f815500cc81e82ee4ea9756deeb5c9fc45f

# emscripten SDK のバージョン。ローカル開発環境(PC98/emsdk、symlink先)と
# 揃えてある。ツールチェーンの版で挙動が変わる余地を減らすための固定で、
# 上の upstream 各リポジトリとは別の理由(再現性)による固定。
EMSDK_VERSION=6.0.5
