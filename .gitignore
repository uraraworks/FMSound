# 独立した外部リポジトリ群(79MB)。各自が自分の repo を持つので追跡しない。
/upstream/

# ビルド成果物(7.4MB)。CMake キャッシュに絶対パスが焼かれるため移植性も無い。
/pmdweb/build-web/
/mucomweb/build-web/

# tools/build_dist.sh が組み立てる、1アプリ化後のGitHub Pages配信用ディレクトリ
# (両エンジンのwasm+共有html/fmdsp/uiを1箇所に集めたもの)。build-web/と同じ理由で
# 生成物のため追跡しない。
/dist/

# ツールチェーンへの symlink(実体は ../PC98/emsdk)。
/emsdk

# 生成したプレビュー画像(tools/render_*.mjs の出力)。
/rightpane-preview.png
/trackrow-preview.png
/tools/*.png

# tools/gen_version.py が git コミット日時/ハッシュから生成するバージョン情報。
# コミットしなくてもビルドのたびに内容が変わりうる(HEADが動けば変わる)ため
# 追跡しない(mucomweb/CMakeLists.txt の generate_version ターゲット参照)。
/ui/version.js

# tools/gen_net_config.py が環境変数 DISK_PROXY_URL から生成する中継サーバー設定。
# forkしたリポジトリ・手元ビルドごとに値が変わりうる(公開先の中継URLを埋め込むため)。
/net/config.js

# Claude Code のローカル設定(preview_start用launch.json等)。手元環境ごとに
# 変わりうる個人設定のため追跡しない。
/.claude/

.DS_Store
