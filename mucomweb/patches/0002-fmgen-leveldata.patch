 void OPNABase::MixSubSL(int activech, ISample** dest)
 {
-	if (activech & 0x001) (*dest[0]  = ch[0].CalcL());
-	if (activech & 0x004) (*dest[1] += ch[1].CalcL());
-	if (activech & 0x010) (*dest[2] += ch[2].CalcL());
-	if (activech & 0x040) (*dest[3] += ch[3].CalcL());
-	if (activech & 0x100) (*dest[4] += ch[4].CalcL());
-	if (activech & 0x400) (*dest[5] += ch[5].CalcL());
+	if (activech & 0x001) { ISample s = ch[0].CalcL(); UpdateFmLevel(0, s); (*dest[0]  = s); }
+	if (activech & 0x004) { ISample s = ch[1].CalcL(); UpdateFmLevel(1, s); (*dest[1] += s); }
+	if (activech & 0x010) { ISample s = ch[2].CalcL(); UpdateFmLevel(2, s); (*dest[2] += s); }
+	if (activech & 0x040) { ISample s = ch[3].CalcL(); UpdateFmLevel(3, s); (*dest[3] += s); }
+	if (activech & 0x100) { ISample s = ch[4].CalcL(); UpdateFmLevel(4, s); (*dest[4] += s); }
+	if (activech & 0x400) { ISample s = ch[5].CalcL(); UpdateFmLevel(5, s); (*dest[5] += s); }
 }
 
 inline void OPNABase::MixSubS(int activech, ISample** dest)
 {
-	if (activech & 0x001) (*dest[0]  = ch[0].Calc());
-	if (activech & 0x004) (*dest[1] += ch[1].Calc());
-	if (activech & 0x010) (*dest[2] += ch[2].Calc());
-	if (activech & 0x040) (*dest[3] += ch[3].Calc());
-	if (activech & 0x100) (*dest[4] += ch[4].Calc());
-	if (activech & 0x400) (*dest[5] += ch[5].Calc());
+	if (activech & 0x001) { ISample s = ch[0].Calc(); UpdateFmLevel(0, s); (*dest[0]  = s); }
+	if (activech & 0x004) { ISample s = ch[1].Calc(); UpdateFmLevel(1, s); (*dest[1] += s); }
+	if (activech & 0x010) { ISample s = ch[2].Calc(); UpdateFmLevel(2, s); (*dest[2] += s); }
+	if (activech & 0x040) { ISample s = ch[3].Calc(); UpdateFmLevel(3, s); (*dest[3] += s); }
+	if (activech & 0x100) { ISample s = ch[4].Calc(); UpdateFmLevel(4, s); (*dest[4] += s); }
+	if (activech & 0x400) { ISample s = ch[5].Calc(); UpdateFmLevel(5, s); (*dest[5] += s); }
+}
+
+// ---------------------------------------------------------------------------
+//	FMSound patch (mucomweb/patches/0002-fmgen-leveldata.patch): per-channel
+//	level peak-hold (FM). See declaration in opna.h for rationale.
+//
+void OPNABase::UpdateFmLevel(int ch, ISample s)
+{
+	unsigned level = (unsigned)(s < 0 ? -s : s);
+	if (fmlevelread_[ch] || level > fmlevel_[ch]) fmlevel_[ch] = level;
+	fmlevelread_[ch] = false;
+}
+
+unsigned OPNABase::GetFmLevel(int ch)
+{
+	unsigned level = fmlevel_[ch];
+	fmlevelread_[ch] = true;
+	return level;
+}
+
+void OPNABase::UpdateAdpcmLevel(ISample s)
+{
+	unsigned level = (unsigned)(s < 0 ? -s : s);
+	if (adpcmlevelread_ || level > adpcmlevel_) adpcmlevel_ = level;
+	adpcmlevelread_ = false;
+}
+
+unsigned OPNABase::GetAdpcmLevel(void)
+{
+	unsigned level = adpcmlevel_;
+	adpcmlevelread_ = true;
+	return level;
 }
 
