# 製品採用済み。CMakeLists.txtが0001-0003と同じ作法で冪等に適用する(4本目)。
#
# 背景: mucomweb/src/MucomWeb.cpp の CompileMML() は CMucom::Compile() を直接呼び、
# CMucom::ProcessHeader() を一度も呼ばない。CMucom::Compile()(cmucom.cpp:1244-1250)は
# `#voice <file>` のファイル名を GetInfoBufferByName("voice") で読むが、この値は
# ProcessHeader()(cmucom.cpp:1140-1172、MMLを1行ずつ走査して`#`始まりの行を
# infobufへ溜め込む)を呼ばない限り空(NULL)のままで、`#voice` タグは常に無視される。
# ProcessHeader(char *text) はcmucom.h:245で宣言されており、CMucom::CompileFile()
# (cmucom.cpp:1356-1358)が実際に使っている呼び出し順序
#   ProcessHeader(mml);
#   res = Compile(mml, sname, option);
# をそのまま踏襲する。
#
# 実験での確認結果はdocs/voice-external-bank-experiment.md参照(実曲46曲中12曲を
# 対象にした再検証で11/12曲が成功、外部バンクの内容が波形へ反映されることを実測)。
# 外部バンクの製品配線(対になるシステムディスクからvoice.datを見つけて#voiceへ渡す)は
# html/mucom-app.js・net/voice-bank.js側の責務(このパッチはProcessHeader()呼び出しの
# 追加のみを担当する)。
#
# 0001-0003と異なり、このパッチの対象(mucomweb/src/MucomWeb.cpp)はFMSound本体が
# 直接git管理しているファイル(upstream/配下の無改変クローンではない)。そのため
# ProcessHeader()呼び出し自体は既にこのファイルへ直接コミット済みで、
# mucomweb/CMakeLists.txtの冪等適用ブロックは通常「reverse --check」が成功
# (=既に当たっている)して何もしない。ここでの適用ステップは、万一その行だけが
# 取り除かれた場合に気付かず古い挙動(#voice無視)へ戻ってしまうことを防ぐ保険
# (0001-0003と同じ「警告でなく失敗させる」考え方)。
#
# 適用対象はFMSoundリポジトリルート(mucomweb/CMakeLists.txtの1つ上):
#   git apply mucomweb/patches/0004-compilemml-processheader.patch
diff --git a/mucomweb/src/MucomWeb.cpp b/mucomweb/src/MucomWeb.cpp
index 15df2b9..22608a2 100644
--- a/mucomweb/src/MucomWeb.cpp
+++ b/mucomweb/src/MucomWeb.cpp
@@ -456,6 +456,16 @@ std::string CompileMML(const std::string& mml, int sampleRate)
 	CMucom mucomCompiler;
 	mucomCompiler.Init();
 	mucomCompiler.Reset(2);
+	// #voice(外部音色バンク)を機能させるための呼び出し(mucomweb/patches/
+	// 0004-compilemml-processheader.patch、docs/voice-external-bank-experiment.md参照)。
+	// CMucom::Compile()内のGetInfoBufferByName("voice")(cmucom.cpp:1246)はinfobufを
+	// 見るが、そのinfobufはProcessHeader()(cmucom.cpp:1140-1172)がMMLを1行ずつ走査して
+	// `#`始まりの行を溜め込むまで空(NULL)のまま。呼ばないと`#voice`タグは常に無視される。
+	// CMucom::CompileFile()(cmucom.cpp:1356-1358)が使っている呼び出し順序
+	// (ProcessHeader(mml); Compile(mml, ...);)をそのまま踏襲する。
+	// この行は上記パッチをファイルへ直接コミットしたもの(mucomweb/CMakeLists.txtの
+	// 冪等適用ブロックは「既に当たっている」を検出してスキップする、通常運用では無変更)。
+	mucomCompiler.ProcessHeader(const_cast<char *>(mml.c_str()));
 	if (mucomCompiler.Compile(const_cast<char *>(mml.c_str()), mubPath) >= 0)
